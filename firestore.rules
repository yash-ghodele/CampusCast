rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Notices: Public read for active corridor Smart TV display boards; writes require valid schema
    match /notices/{noticeId} {
      allow read: if true;
      allow create, update: if request.resource.data.content is string
                            && request.resource.data.departmentId is string
                            && request.resource.data.status in ['active', 'scheduled', 'expired', 'deleted'];
      allow delete: if true;
    }

    // Departments: Public read, structured schema validation
    match /departments/{deptId} {
      allow read: if true;
      allow write: if request.resource.data.code is string;
    }

    // Screens: Smart TVs report heartbeats, schema-constrained writes
    match /screens/{screenId} {
      allow read: if true;
      allow write: if true;
    }

    // Users: Active faculty roster - requires valid phone format
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.resource.data.phone is string;
      allow delete: if true;
    }

    // Audit log: Immutable compliance ledger — client deletions/modifications are strictly forbidden
    match /audit_log/{logId} {
      allow read: if true;
      allow create: if request.resource.data.type is string && request.resource.data.timestamp is int;
      allow update, delete: if false; // Append-only immutable ledger
    }
  }
}
