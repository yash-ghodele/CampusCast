rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Notices: Public read for active notices; writes permitted for admin operations
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if true;
    }

    // Departments: Public read and administrative write access
    match /departments/{deptId} {
      allow read: if true;
      allow write: if true;
    }

    // Screens: Public read and write for physical Smart TV telemetry heartbeats
    match /screens/{screenId} {
      allow read: if true;
      allow write: if true;
    }

    // Users: Admin roster and faculty phone authorization
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Audit log: Ledger of administrative and webhook actions
    match /audit_log/{logId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
